# Create a Supabase project, run ../supabase/schema.sql in its SQL editor, then copy this file to backend/.env.
# .env holds non-secret settings. Put REAL secrets (GROQ_API_KEY, SUPABASE keys) in backend/.env.local instead —
# it is git-ignored, loaded with override, and never committed.
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# GROQ_API_KEY lives in backend/.env.local, e.g.:
# GROQ_API_KEY=gsk_your-real-key
# Current Groq model with JSON-mode support. Change if your account uses another model.
GROQ_MODEL=openai/gpt-oss-120b
# Cheaper/faster model for simple AI tasks (vocab check). Falls back to GROQ_MODEL.
GROQ_FAST_MODEL=groq/compound-mini
